# ── Copy this file to .env and fill in your keys ────────────────────────────
# NEVER commit .env to git. It's already in .gitignore.

# Anthropic (Claude AI) — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Finnhub — https://finnhub.io  (free tier: 60 req/min)
FINNHUB_API_KEY=

# Alpha Vantage — https://www.alphavantage.co/support/#api-key  (free: 25 req/day)
ALPHA_VANTAGE_KEY=

# NewsAPI — https://newsapi.org/register  (free: 100 req/day)
NEWS_API_KEY=

# FRED (Federal Reserve) — https://fred.stlouisfed.org/docs/api/api_key.html  (free)
FRED_API_KEY=

# Reddit — DISABLED (requires manual verification now, re-enable later)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=AI_Trader/1.0 by YourRedditUsername

# Notifications (Phase 3 — not needed yet)
